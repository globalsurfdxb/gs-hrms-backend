{
  "name": "hrms-backend",
  "version": "0.0.1",
  "description": "GS HRMS backend — NestJS modular monolith on PostgreSQL",
  "author": "Global Surf IT",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src/ test/",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "check": "npm run format:check && npm run lint && npm run lint:arch && npm run typecheck && npm test && npm run test:e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "openapi:export": "nest build && node dist/cli/export-openapi.js",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "flow:pdf": "node flow/build.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/msal-node": "^7.1.0",
    "@azure/storage-blob": "^12.34.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^18.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mermaid": "^12.2.0",
    "oxlint": "^1.58.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs,json,md,yml,yaml}": "prettier --write --ignore-unknown",
    "*.ts": "oxlint"
  },
  "overrides": {
    "multer": "2.5.0",
    "@azure/identity": {
      "@azure/msal-node": "$@azure/msal-node"
    }
  }
}
