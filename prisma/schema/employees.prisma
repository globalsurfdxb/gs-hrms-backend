// Employee record. Owned by src/modules/employees.
// Phase 0 holds only what sign-in, permissions and org placement need. Phase 1 adds the profile tables
// (personal, identity documents, bank, salary, education, experience, family, emergency contacts).
// Sensitive identity and bank columns are stored encrypted — see docs/security.md#field-encryption.

enum EmploymentStatus {
  ONBOARDING
  ACTIVE
  OFFBOARDING
  INACTIVE

  @@map("employment_status")
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PROBATION

  @@map("employment_type")
}

model Employee {
  id                 String           @id @default(uuid(7)) @db.Uuid
  /// GS-NNN, shown everywhere in the UI.
  employeeCode       String           @unique @map("employee_code")
  /// Microsoft Entra object id (oid). Linked on first SSO sign-in. Identity is matched on this, not on email.
  entraObjectId      String?          @unique @map("entra_object_id") @db.Uuid
  /// Work email, stored lower-case.
  email              String           @unique
  fullName           String           @map("full_name")
  locationId         String           @map("location_id")
  companyId          String           @map("company_id") @db.Uuid
  departmentId       String?          @map("department_id") @db.Uuid
  designationId      String?          @map("designation_id") @db.Uuid
  reportingManagerId String?          @map("reporting_manager_id") @db.Uuid
  roleId             String           @map("role_id") @db.Uuid
  employmentStatus   EmploymentStatus @default(ONBOARDING) @map("employment_status")
  employmentType     EmploymentType   @map("employment_type")
  dateOfJoining      DateTime         @map("date_of_joining") @db.Date
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  location         Location     @relation(fields: [locationId], references: [id])
  company          Company      @relation(fields: [companyId], references: [id])
  department       Department?  @relation(fields: [departmentId], references: [id])
  designation      Designation? @relation(fields: [designationId], references: [id])
  reportingManager Employee?    @relation("ReportingLine", fields: [reportingManagerId], references: [id])
  directReports    Employee[]   @relation("ReportingLine")
  role             Role         @relation(fields: [roleId], references: [id])
  sessions         Session[]
  headOf           Department[] @relation("DepartmentHead")

  // Profile (Phase 1): personal details and the lists the profile page edits.
  profile           EmployeeProfile?
  emergencyContacts EmergencyContact[]
  experience        WorkExperience[]
  education         Education[]
  family            FamilyMember[]

  // Hiring (src/modules/hiring) — references only; hiring owns these tables.
  requisitionsReplacing   Requisition[]     @relation("RequisitionReplaces")
  requisitionsManaged     Requisition[]     @relation("RequisitionHiringManager")
  requisitionsRaised      Requisition[]     @relation("RequisitionCreatedBy")
  requisitionStepsDecided RequisitionStep[] @relation("RequisitionStepDecidedBy")
  jobsRecruiting          Job[]             @relation("JobRecruiter")
  jobsHandedOver          Job[]             @relation("JobTaManager")
  jobsCreated             Job[]             @relation("JobCreatedBy")
  jobPanels               JobPanelMember[]  @relation("JobPanel")
  jobEvents               JobEvent[]        @relation("JobEventActor")
  candidatesReferred      Candidate[]       @relation("CandidateReferrer")
  candidatesCreated       Candidate[]       @relation("CandidateCreatedBy")
  candidateNotes          CandidateNote[]   @relation("CandidateNoteAuthor")
  applicationsCreated     Application[]     @relation("ApplicationCreatedBy")
  stageChanges            StageChange[]     @relation("StageChangeActor")

  @@index([reportingManagerId])
  @@index([locationId])
  @@index([companyId, departmentId])
  @@map("employees")
}

// ---------------------------------------------------------------------------------------------------------------
// Profile — personal details, not identity, bank or salary (those are encrypted and arrive in their own tables).
// Values use the frontend's labels (lib/options.ts), validated by the DTOs. One row per employee, created on first save.

model EmployeeProfile {
  employeeId       String    @id @map("employee_id") @db.Uuid
  /// India keeps the name in parts; the full name (as per passport) stays on employees.full_name.
  firstName        String?   @map("first_name")
  middleName       String?   @map("middle_name")
  lastName         String?   @map("last_name")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  nationality      String?
  /// Male | Female | Other
  gender           String?
  /// Single | Married | Divorced | Widowed
  maritalStatus    String?   @map("marital_status")
  /// O+ O- A+ A- B+ B- AB+ AB-
  bloodGroup       String?   @map("blood_group")
  personalEmail    String?   @map("personal_email")
  personalMobile   String?   @map("personal_mobile")
  currentAddress   String?   @map("current_address")
  permanentAddress String?   @map("permanent_address")
  workPhone        String?   @map("work_phone")
  extension        String?
  seatingLocation  String?   @map("seating_location")
  probationEnd     DateTime? @map("probation_end") @db.Date
  /// As the frontend shows it, e.g. "4 yr 6 mo".
  totalExperience  String?   @map("total_experience")
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

/// Lists keep the order the person entered them in (`position`); a save replaces the whole list.
model EmergencyContact {
  id           String @id @default(uuid(7)) @db.Uuid
  employeeId   String @map("employee_id") @db.Uuid
  position     Int
  /// UAE: Local Emergency Contact (UAE) | Home Country Emergency Contact; India: Primary | Alternate Emergency Contact.
  group        String
  name         String
  relationship String
  mobile       String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

model WorkExperience {
  id         String    @id @default(uuid(7)) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  position   Int
  company    String
  location   String    @default("")
  fromDate   DateTime? @map("from_date") @db.Date
  toDate     DateTime? @map("to_date") @db.Date
  title      String    @default("")
  /// Onsite | Remote | Hybrid
  workMode   String    @default("") @map("work_mode")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_experience")
}

model Education {
  id            String @id @default(uuid(7)) @db.Uuid
  employeeId    String @map("employee_id") @db.Uuid
  position      Int
  qualification String
  institution   String @default("")
  course        String @default("")
  field         String @default("")
  startYear     Int?   @map("start_year")
  endYear       Int?   @map("end_year")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_education")
}

model FamilyMember {
  id           String    @id @default(uuid(7)) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  position     Int
  name         String
  relationship String
  occupation   String    @default("")
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_family")
}
