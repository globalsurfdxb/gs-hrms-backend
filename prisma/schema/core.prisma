// Core platform tables: access control, sessions and the audit trail.

/// A role people sign in with. The five system roles mirror the frontend (lib/types.ts `Role`).
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String   @default("")
  /// System roles cannot be renamed or deleted.
  system      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  employees   Employee[]

  @@map("roles")
}

/// One granted permission key. Keys use the frontend catalogue format (lib/access.ts):
/// `<feature-id>` grants View; `<feature-id>#add|edit|delete` grants the other actions.
model RolePermission {
  roleId String @map("role_id") @db.Uuid
  key    String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, key])
  @@map("role_permissions")
}

enum AuthMethod {
  ENTRA
  DEV

  @@map("auth_method")
}

/// Server-side session. The cookie holds a random token; only its SHA-256 hash is stored here,
/// so a database leak does not leak usable sessions.
model Session {
  id         String     @id @default(uuid(7)) @db.Uuid
  tokenHash  String     @unique @map("token_hash")
  employeeId String     @map("employee_id") @db.Uuid
  method     AuthMethod
  ip         String?
  userAgent  String?    @map("user_agent")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute expiry. Idle expiry is checked against last_seen_at.
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("sessions")
}

/// Append-only audit trail. A database trigger (see the init migration) rejects UPDATE and DELETE.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz(3)
  /// The signed-in employee, or null for system jobs and unauthenticated events (failed sign-in).
  actorId    String?  @map("actor_id") @db.Uuid
  /// Name at the time of the event, "system", or the attempted email for failed sign-ins.
  actorLabel String   @map("actor_label")
  /// Area of the app — matches the frontend audit modules (Organization, Security, Hiring, ...).
  module     String
  /// What happened, e.g. "company.created", "auth.sign_in", "auth.sign_in_failed".
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([at])
  @@map("audit_logs")
}
