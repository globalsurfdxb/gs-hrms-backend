// Hiring Management. Owned by src/modules/hiring. Spec: docs/modules/hiring.md.
// Built step by step (spec §11): step 1 = requisitions and their approval steps, step 2 = jobs, step 3 = candidates.

enum HiringEmploymentType {
  FULL_TIME
  CONTRACT
  INTERN

  @@map("hiring_employment_type")
}

enum RequisitionReason {
  NEW_ROLE
  REPLACEMENT

  @@map("requisition_reason")
}

enum RequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ON_HOLD
  CLOSED

  @@map("requisition_status")
}

/// The fixed approval chain (lead decision 2026-10-22): Hiring Manager → HR → Management.
enum RequisitionStepLabel {
  HIRING_MANAGER
  HR
  MANAGEMENT

  @@map("requisition_step_label")
}

enum RequisitionStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED

  @@map("requisition_step_status")
}

/// A request for headcount. Only an APPROVED requisition can become a job.
model Requisition {
  id                 String               @id @default(uuid(7)) @db.Uuid
  /// REQ-0001, from a sequence so concurrent saves never share a code (see the migration).
  code               String               @unique @default(dbgenerated("('REQ-'::text || lpad((nextval('hiring_requisition_code_seq'::regclass))::text, 4, '0'::text))"))
  title              String
  companyId          String               @map("company_id") @db.Uuid
  departmentId       String               @map("department_id") @db.Uuid
  designationId      String?              @map("designation_id") @db.Uuid
  locationId         String               @map("location_id")
  positions          Int
  employmentType     HiringEmploymentType @map("employment_type")
  reason             RequisitionReason
  replacesEmployeeId String?              @map("replaces_employee_id") @db.Uuid
  /// Monthly (UAE) or yearly CTC (India) budget per position, in the location's currency.
  budgetMin          Decimal              @map("budget_min") @db.Decimal(14, 2)
  budgetMax          Decimal              @map("budget_max") @db.Decimal(14, 2)
  currency           String               @db.Char(3)
  targetStart        DateTime             @map("target_start") @db.Date
  hiringManagerId    String               @map("hiring_manager_id") @db.Uuid
  justification      String
  status             RequisitionStatus    @default(DRAFT)
  createdById        String               @map("created_by_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department    Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation   Designation?      @relation(fields: [designationId], references: [id], onDelete: SetNull)
  location      Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  replaces      Employee?         @relation("RequisitionReplaces", fields: [replacesEmployeeId], references: [id], onDelete: Restrict)
  hiringManager Employee          @relation("RequisitionHiringManager", fields: [hiringManagerId], references: [id], onDelete: Restrict)
  createdBy     Employee          @relation("RequisitionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  steps         RequisitionStep[]
  job           Job?

  @@index([status])
  @@index([locationId])
  @@index([hiringManagerId])
  @@index([createdById])
  @@map("requisitions")
}

/// One step of a requisition's approval chain. Recreated on every (re)submit.
model RequisitionStep {
  requisitionId String                @map("requisition_id") @db.Uuid
  /// 1, 2, 3 — the chain order.
  position      Int
  label         RequisitionStepLabel
  status        RequisitionStepStatus @default(WAITING)
  decidedById   String?               @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?             @map("decided_at") @db.Timestamptz(3)
  note          String?

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  decidedBy   Employee?   @relation("RequisitionStepDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@id([requisitionId, position])
  /// Finds requisitions waiting on a given step (approval inbox).
  @@index([label, status])
  @@map("requisition_steps")
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
  /// Set by the system when filled = positions (offers, step 5) — never by a person.
  FILLED

  @@map("job_status")
}

/// A vacancy opened from one APPROVED requisition. Title, company, department, location, positions, budget and hiring
/// manager are read from the requisition (it cannot change once approved), so they are not copied here.
model Job {
  id               String    @id @default(uuid(7)) @db.Uuid
  /// JOB-0001, from a sequence so concurrent saves never share a code (see the migration).
  code             String    @unique @default(dbgenerated("('JOB-'::text || lpad((nextval('hiring_job_code_seq'::regclass))::text, 4, '0'::text))"))
  requisitionId    String    @unique @map("requisition_id") @db.Uuid
  /// The grade hired at; defaults to the requisition's. Must belong to the requisition's department.
  designationId    String?   @map("designation_id") @db.Uuid
  description      String
  skills           String[]
  expMin           Int       @map("exp_min")
  expMax           Int       @map("exp_max")
  qualifications   String    @default("")
  referralEligible Boolean   @default(true) @map("referral_eligible")
  closingDate      DateTime  @map("closing_date") @db.Date
  recruiterId      String    @map("recruiter_id") @db.Uuid
  /// Accepted offers counted against positions (offers, step 5).
  filled           Int       @default(0)
  status           JobStatus @default(DRAFT)
  createdById      String    @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  requisition  Requisition      @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  designation  Designation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  recruiter    Employee         @relation("JobRecruiter", fields: [recruiterId], references: [id], onDelete: Restrict)
  createdBy    Employee         @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  panel        JobPanelMember[]
  events       JobEvent[]
  applications Application[]

  @@index([status])
  @@index([recruiterId])
  @@map("jobs")
}

/// Interviewers for a job (at least one).
model JobPanelMember {
  jobId      String @map("job_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee Employee @relation("JobPanel", fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([jobId, employeeId])
  @@index([employeeId])
  @@map("job_panel_members")
}

/// The job's History tab: created, opened, put on hold, recruiter changed, filled… Append-only.
model JobEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(3)
  /// null = the system (e.g. FILLED when the last position is filled).
  actorId    String?  @map("actor_id") @db.Uuid
  actorLabel String   @map("actor_label")
  text       String

  /// Restrict: history is append-only, so a job that has history cannot be deleted.
  job   Job       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  actor Employee? @relation("JobEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([jobId, at])
  @@map("job_events")
}

// ---------------------------------------------------------------------------------------------------------------
// Step 3: candidates, applications, pipeline (spec §3, BR-HIR-007…009).

enum CandidateSource {
  LINKEDIN
  NAUKRI
  BAYT
  INDEED
  EMPLOYEE_REFERRAL
  AGENCY
  /// The company website's careers page (jobs are posted there by hand; nothing in the HRMS is public).
  CAREERS_PAGE
  DIRECT

  @@map("candidate_source")
}

enum ApplicationStage {
  APPLIED
  SCREENING
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  OFFER
  /// Set only by an accepted offer (BR-HIR-013).
  HIRED

  @@map("application_stage")
}

enum ApplicationExit {
  REJECTED
  WITHDRAWN
  ON_HOLD

  @@map("application_exit")
}

/// A person HR is considering. Salary is protected by access, not encryption (spec Q8): omitted from responses for
/// callers without salary access, never logged, audited without amounts.
model Candidate {
  id              String          @id @default(uuid(7)) @db.Uuid
  name            String
  /// Stored lower-case; one candidate per email (BR-HIR-007).
  email           String          @unique
  phone           String
  /// Last 9 digits of the phone, for the duplicate check.
  phoneKey        String          @map("phone_key")
  /// The hiring location they are considered for (the job's when added to a job).
  locationId      String          @map("location_id")
  currentCity     String          @default("") @map("current_city")
  currentCompany  String          @default("") @map("current_company")
  currentTitle    String          @default("") @map("current_title")
  experienceYears Decimal         @map("experience_years") @db.Decimal(4, 1)
  noticeDays      Int             @default(0) @map("notice_days")
  currentSalary   Decimal?        @map("current_salary") @db.Decimal(14, 2)
  expectedSalary  Decimal?        @map("expected_salary") @db.Decimal(14, 2)
  /// From the location.
  currency        String          @db.Char(3)
  visaStatus      String          @default("") @map("visa_status")
  source          CandidateSource
  referrerId      String?         @map("referrer_id") @db.Uuid
  agency          String?
  /// File name only until file storage exists (decided 2026-10-23).
  cvName          String?         @map("cv_name")
  links           String          @default("")
  tags            String[]
  consentGivenAt  DateTime        @map("consent_given_at") @db.Timestamptz(3)
  createdById     String          @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  location     Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  referrer     Employee?       @relation("CandidateReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  createdBy    Employee        @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  notes        CandidateNote[]
  applications Application[]

  @@index([phoneKey])
  @@index([locationId])
  @@index([referrerId])
  @@map("candidates")
}

/// Notes on a candidate. Append-only (trigger).
model CandidateNote {
  id          String   @id @default(uuid(7)) @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  text        String
  authorId    String   @map("author_id") @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz(3)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  author    Employee  @relation("CandidateNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([candidateId, at])
  @@map("candidate_notes")
}

/// A candidate applying to one job (one per pair, BR-HIR-008). The location is the job's, read through it.
model Application {
  id          String            @id @default(uuid(7)) @db.Uuid
  candidateId String            @map("candidate_id") @db.Uuid
  jobId       String            @map("job_id") @db.Uuid
  stage       ApplicationStage  @default(APPLIED)
  exit        ApplicationExit?
  /// The stage it left the pipeline from, so Reopen can put it back.
  exitFrom    ApplicationStage? @map("exit_from")
  exitReason  String?           @map("exit_reason")
  exitNote    String?           @map("exit_note")
  appliedAt   DateTime          @default(now()) @map("applied_at") @db.Timestamptz(3)
  createdById String            @map("created_by_id") @db.Uuid
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  candidate Candidate     @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  createdBy Employee      @relation("ApplicationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  history   StageChange[]

  @@unique([candidateId, jobId])
  @@index([jobId, stage])
  @@map("applications")
}

/// An application's stage history (from/to are stage or exit codes). Append-only (trigger).
model StageChange {
  id            String   @id @default(uuid(7)) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  at            DateTime @default(now()) @db.Timestamptz(3)
  /// null = the system (e.g. HIRED when an offer is accepted).
  actorId       String?  @map("actor_id") @db.Uuid
  actorLabel    String   @map("actor_label")
  /// null on the first line ("applied").
  from          String?
  to            String
  note          String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actor       Employee?   @relation("StageChangeActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, at])
  @@map("application_stage_changes")
}
