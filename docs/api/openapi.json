    "/api/auth/dev/login": {
      "post": {
        "description": "Local development and tests only (404 elsewhere). Sets the session cookie, so every later request in Swagger / Bruno is signed in. GS-120 Super Admin · GS-119 HR · GS-101 Office Admin · GS-058 Team Lead · GS-087 Employee.",
        "operationId": "AuthController_devLogin",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevLoginDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Signed in — session cookie set"
          },
          "400": {
            "description": "Invalid input (code `request.invalid`, field errors in `details.fields`) or a business rule failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Signed in but not allowed (missing permission, or request from another origin)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found — or the caller is not allowed to know it exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests — slow down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Dev sign-in as a seeded persona",
        "tags": [
          "Auth"
        ]
      }
    },
