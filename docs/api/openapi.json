  "info": {
    "title": "GS HRMS API",
    "description": "\nAPI for GS HRMS. **Generated from the code** — every endpoint must be documented (CI checks it).\nBusiness rules and flows: `docs/modules/*.md` and the PDFs in `flow/`. Testing guide: `docs/api-guide.md`.\n\n### Try it in 3 steps\n1. Open **Auth → POST /api/auth/dev/login**, click **Try it out**, send `{ \"employeeCode\": \"GS-120\" }`.\n   The session cookie is now set in this browser.\n2. Call any endpoint with **Try it out** — you are signed in as that persona.\n3. Switch persona by signing in again (GS-119 HR · GS-101 Office Admin · GS-058 Team Lead · GS-087 Employee).\n\n### Errors\nEvery error has the same body: `{ statusCode, code, message, details?, requestId }`. Switch on `code`.\n",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "hrms_sid"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 403
          },
          "code": {
            "type": "string",
            "example": "auth.forbidden",
            "description": "Stable code — the frontend switches on this"
          },
          "message": {
            "type": "string",
            "example": "You do not have access to this"
          },
          "details": {
            "type": "object",
            "description": "Field errors for request.invalid"
          },
          "requestId": {
            "type": "string",
            "example": "req-42",
            "description": "Quote this when reporting a problem"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "DevLoginDto": {
        "type": "object",
        "properties": {
          "employeeCode": {
            "type": "string",
            "example": "GS-120",
            "description": "Employee code of a seeded persona"
          }
        },
        "required": [
          "employeeCode"
        ]
      },
      "DevPersonaResponse": {
        "type": "object",
        "properties": {
          "employeeCode": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "employeeCode",
          "fullName",
          "role"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "employeeId": {
            "type": "string"
          },
          "employeeCode": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "locationId": {
            "type": "string"
          },
          "companyId": {
            "type": "string"
          },
          "permissions": {
            "description": "Granted permission keys (frontend catalogue format)",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "employeeId",
          "employeeCode",
          "fullName",
          "email",
          "role",
          "locationId",
          "companyId",
          "permissions"
        ]
      },
      "CompanyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "shortCode": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "description": "Location id, or \"Both\""
          },
          "established": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "shortCode",
          "description",
          "website",
          "location",
          "established",
          "status",
          "updatedAt"
        ]
      },
      "CreateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "GS Digital"
          },
          "shortCode": {
            "type": "string",
            "example": "GSD",
            "description": "2–8 letters or digits; stored upper-case"
          },
          "description": {
            "type": "string",
            "example": "Digital marketing and software solutions."
          },
          "website": {
            "type": "string",
            "example": "www.gsdigital.ae"
          },
          "location": {
            "type": "string",
            "example": "Dubai",
            "description": "A location id, or \"Both\" for every location"
          },
          "established": {
            "type": "string",
            "example": "2019"
          }
        },
        "required": [
          "name",
          "shortCode",
          "location"
        ]
      },
      "UpdateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "GS Digital"
          },
          "shortCode": {
            "type": "string",
            "example": "GSD",
            "description": "2–8 letters or digits; stored upper-case"
          },
          "description": {
            "type": "string",
            "example": "Digital marketing and software solutions."
          },
          "website": {
            "type": "string",
            "example": "www.gsdigital.ae"
          },
          "location": {
            "type": "string",
            "example": "Dubai",
            "description": "A location id, or \"Both\" for every location"
          },
          "established": {
            "type": "string",
            "example": "2019"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      }
    }
  }
}
