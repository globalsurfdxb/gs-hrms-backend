# Copy to .env for local development:  cp .env.example .env
# Never commit .env. In Azure these values come from App Service settings backed by Key Vault references.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# The frontend origin. State-changing requests from any other origin are rejected.
APP_ORIGIN=http://localhost:3000
# Proxies in front of the app (Azure Front Door → App Service = 2). Keep 0 locally.
TRUST_PROXY_HOPS=0

# Local Postgres from docker-compose.yml
DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms?schema=public

# --- Sessions -----------------------------------------------------------------
# Signs short-lived auth cookies. Generate with:  openssl rand -base64 48
SESSION_COOKIE_SECRET=change-me-generate-with-openssl-rand-base64-48
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# --- Sign-in --------------------------------------------------------------------
# Dev login lets you sign in as a seeded persona without Microsoft. Refused when NODE_ENV=production.
AUTH_DEV_LOGIN=true
# Password of the demo accounts (…@hrms.local) on the email + password form. The form is on everywhere, production
# included, until Microsoft sign-in is set up.
DEV_LOGIN_PASSWORD=demo1234

# Microsoft Entra ID (M365 SSO). Leave empty until IT provides the app registration.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3001/api/auth/callback

# --- Field encryption (passport, Emirates ID, Aadhaar, PAN, bank account) ---------
# 32-byte keys, base64. Generate each with:  openssl rand -base64 32
# Production keys live in Key Vault only.
FIELD_ENCRYPTION_KEY=
FIELD_BLIND_INDEX_KEY=

# --- File storage ---------------------------------------------------------------
# Local: Azurite from docker-compose.yml. Azure: leave empty and set AZURE_STORAGE_ACCOUNT_URL (Managed Identity).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_ACCOUNT_URL=

# --- Mail / PDF (local catchers from docker-compose.yml) ------------------------
SMTP_URL=smtp://localhost:1025
GOTENBERG_URL=http://localhost:3002
