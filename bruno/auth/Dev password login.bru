meta {
  name: Dev password login
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/dev/password-login
  body: json
  auth: none
}

headers {
  Origin: {{origin}}
}

body:json {
  {
    "email": "gs-120@hrms.local",
    "password": "demo1234"
  }
}

docs {
  Local development only (404 elsewhere). The login page's email + password form: only the seeded demo
  accounts (…@hrms.local — see "Dev personas") with DEV_LOGIN_PASSWORD from the backend .env (default demo1234).
  A wrong password or unknown email returns 401 auth.invalid_credentials.
}

tests {
  test("signed in", function () {
    expect(res.status).to.equal(204);
  });
}
