meta {
  name: Create designation
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/org/designations
  body: json
  auth: none
}

headers {
  Origin: {{origin}}
}

body:json {
  {
    "departmentId": "{{departmentId}}",
    "title": "Bruno Test Engineer"
  }
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("designationId", res.body.id);
}

docs {
  Run "Create department" first — it fills `departmentId`. Needs Company Structure → Add.
  Saves the new id in `designationId`.
}

tests {
  test("created", function () {
    expect(res.status).to.equal(201);
  });
}
