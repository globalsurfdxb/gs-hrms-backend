meta {
  name: Rename designation
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/org/designations/{{designationId}}
  body: json
  auth: none
}

headers {
  Origin: {{origin}}
}

body:json {
  {
    "title": "Bruno Senior Engineer"
  }
}

docs {
  Needs Company Structure → Edit. Only the title changes.
}

tests {
  test("renamed", function () {
    expect(res.status).to.equal(200);
    expect(res.body.title).to.equal("Bruno Senior Engineer");
  });
}
