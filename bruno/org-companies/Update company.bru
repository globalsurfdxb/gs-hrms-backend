meta {
  name: Update company
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/org/companies/{{companyId}}
  body: json
  auth: none
}

headers {
  Origin: {{origin}}
}

body:json {
  {
    "status": "INACTIVE"
  }
}

docs {
  Needs Companies → Edit. Send only the fields that change.
}

tests {
  test("updated", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("INACTIVE");
  });
}
