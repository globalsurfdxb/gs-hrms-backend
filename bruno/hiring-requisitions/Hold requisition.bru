meta {
  name: Hold requisition
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/hiring/requisitions/{{requisitionId}}/hold
  body: none
  auth: none
}

headers {
  Origin: {{origin}}
}

docs {
  HR / Super Admin only. APPROVED → ON_HOLD. Any other status → 409 `requisition.invalid_transition`.
}

tests {
  test("ON_HOLD (200) — or 409 from the wrong status", function () {
    expect([200, 409]).to.include(res.status);
    if (res.status === 200) expect(res.body.status).to.equal("ON_HOLD");
  });
}
