meta {
  name: Get job
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/hiring/jobs/{{jobId}}
  body: none
  auth: none
}

docs {
  Run "Create job from requisition" first — it fills `jobId`. Includes the History tab and `viewer.actions`
  (the status buttons allowed now).

  Own jobs (BR-HIR-022): signed in as GS-156 Recruiter you get only jobs you recruit for or manage; another
  one is 404. Super Admin, HR and GS-155 Talent Acquisition Manager see everything.
}

tests {
  test("found with history", function () {
    expect(res.status).to.equal(200);
    expect(res.body.history).to.be.an("array");
  });
}
