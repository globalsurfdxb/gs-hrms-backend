meta {
  name: People to pick from
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/hiring/people
  body: none
  auth: none
}

docs {
  Needs Jobs → View (Super Admin, HR, Talent Acquisition Manager, Recruiter). Every active employee with name,
  employee code and designation, for the interview panel picker and — when there is no Talent Acquisition Manager —
  the recruiter picker. No contact details. As GS-058 (Team Lead) or GS-087 (Employee) this returns 403.
}

tests {
  test("people (200) — or 403 without Jobs → View", function () {
    expect([200, 403]).to.include(res.status);
    if (res.status === 200) expect(res.body).to.be.an("array");
  });
}
