meta {
  name: List jobs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/hiring/jobs?page=1&pageSize=50
  body: none
  auth: none
}

params:query {
  page: 1
  pageSize: 50
  ~status: OPEN
  ~locationId: Dubai
  ~recruiterId: {{reqHiringManagerId}}
}

docs {
  Needs Jobs → View (HR GS-119, Super Admin GS-120). Team Lead, Office Admin and Employee get 403.
}

tests {
  test("paged list (200) — or 403 without Jobs access", function () {
    expect([200, 403]).to.include(res.status);
    if (res.status === 200) expect(res.body.items).to.be.an("array");
  });
}
