meta {
  name: List job pipeline
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/hiring/jobs/{{jobId}}/applications?sort=applied&dir=desc
  body: none
  auth: none
}

params:query {
  sort: applied
  dir: desc
  ~stage: SCREENING
  ~exit: NONE
  ~q: priya
  ~source: LINKEDIN
  ~tag: Shortlisted
  ~appliedWithinDays: 7
  ~inStageForDays: 14
  ~page: 1
  ~pageSize: 50
}

docs {
  Needs Candidates → View. The job's applications with the candidate behind each (board and list).
  `inStageForDays` finds stalled candidates; sort by applied, name, stage or inStage.
}

tests {
  test("pipeline (200)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
  });
}
